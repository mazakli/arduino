generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String         @id @default(cuid())
  username           String         @unique
  email              String         @unique
  passwordHash       String
  createdAt          DateTime       @default(now())
  isAnonymous        Boolean        @default(false)
  teamId             String?
  notificationsCount Int            @default(0)
  team               Team?          @relation(fields: [teamId], references: [id])
  posts              Post[]
  replies            Reply[]
  notifications      Notification[]
  certificates       Certificate[]
  votes              Vote[]
}

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  emoji       String   @default("🤖")
  points      Int      @default(0)
  createdAt   DateTime @default(now())
  members     User[]
}

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String
  icon        String  @default("folder")
  posts       Post[]
}

model Post {
  id                  String        @id @default(cuid())
  title               String
  content             String
  imageUrl            String?
  authorId            String?
  categoryId          String
  createdAt           DateTime      @default(now())
  upvotes             Int           @default(0)
  isSolved            Boolean       @default(false)
  isProject           Boolean       @default(false)
  certificateApproved Boolean       @default(false)
  author              User?         @relation(fields: [authorId], references: [id])
  category            Category      @relation(fields: [categoryId], references: [id])
  replies             Reply[]
  notifications       Notification[]
  certificate         Certificate?
  votes               Vote[]
}

model Reply {
  id            String   @id @default(cuid())
  content       String
  postId        String
  authorId      String?
  createdAt     DateTime @default(now())
  upvotes       Int      @default(0)
  isSolution    Boolean  @default(false)
  quotedReplyId String?
  isAiGenerated Boolean  @default(false)
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author        User?    @relation(fields: [authorId], references: [id])
  quotedReply   Reply?   @relation("QuoteRelation", fields: [quotedReplyId], references: [id])
  quotedBy      Reply[]  @relation("QuoteRelation")
  votes         Vote[]
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  message   String
  postId    String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
}

model Certificate {
  id         String   @id @default(cuid())
  userId     String
  postId     String   @unique
  issuedAt   DateTime @default(now())
  uniqueCode String   @unique @default(cuid())
  user       User     @relation(fields: [userId], references: [id])
  post       Post     @relation(fields: [postId], references: [id])
}

model Vote {
  id       String  @id @default(cuid())
  userId   String
  postId   String?
  replyId  String?
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  post     Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)
  reply    Reply?  @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, replyId])
}
